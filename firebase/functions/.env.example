# Copy this file to functions/.env and edit.
# The 2Factor API KEY is NOT stored here. Set it as a secret:
#   firebase functions:secrets:set TWOFACTOR_API_KEY

# SMS template name approved in your 2Factor dashboard (DLT-registered OTP template)
TWOFACTOR_TEMPLATE=OTP1

# Websites allowed to use the login (comma separated, no trailing slash)
ALLOWED_ORIGINS=https://easyadpromotion.github.io

# First Admin (used only while no Admin exists in Firestore)
BOOTSTRAP_ADMIN=+919398504048
BOOTSTRAP_ADMIN_NAME=CH Appala Naidu
BOOTSTRAP_BRANCH=Gajuwaka HQ
